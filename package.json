{
  "name": "nodewarden",
  "version": "1.8.0",
  "description": "Minimal Bitwarden-compatible server running on Cloudflare Workers",
  "author": "shuaiplus",
  "license": "LGPL-3.0",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "dev:kv": "wrangler dev -c wrangler.kv.toml",
    "dev:demo": "vite --config webapp/vite.config.ts --mode demo --host 127.0.0.1 --port 5174",
    "build": "vite build --config webapp/vite.config.ts",
    "build:demo": "vite build --config webapp/vite.config.ts --mode demo && node scripts/pages-spa-redirects.cjs",
    "domains:sync": "node scripts/sync-global-domains.mjs",
    "i18n": "node scripts/i18n-validate.cjs",
    "i18n:validate": "node scripts/i18n-validate.cjs",
    "i18n:report": "node scripts/i18n-report.cjs",
    "test:config-compatibility": "tsx --test scripts/config-compatibility.test.ts",
    "test:web-crypto": "tsx --test scripts/web-crypto-availability.test.ts",
    "test:webauthn-mobile": "node --test scripts/webauthn-mobile-connector.test.mjs",
    "test:webauthn-connector": "node --test scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:webauthn-connectors": "node --test scripts/webauthn-mobile-connector.test.mjs scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "deploy": "wrangler deploy",
    "deploy:kv": "node scripts/ensure-kv.cjs && wrangler deploy -c wrangler.kv.toml",
    "deploy:demo": "npm run build:demo && wrangler pages deploy dist --project-name nw-demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:api": "oxlint src shared --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:webapp": "vitest run --config vitest.webapp-jsdom.config.ts",
    "coverage:webapp": "vitest run --config vitest.webapp.config.ts --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:demo": "vitest run --config vitest.demo.config.ts",
    "coverage:demo": "vitest run --config vitest.demo.config.ts --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:real": "playwright test --config playwright.realbackend.config.ts",
    "coverage:diff": "node scripts/check-diff-coverage.cjs",
    "coverage:diff:api": "node scripts/check-diff-coverage-api.cjs",
    "overrides:audit": "node scripts/check-stale-overrides.cjs",
    "typecheck:webapp": "tsc -p webapp/tsconfig.json --noEmit",
    "lint": "eslint .",
    "mutation:crypto": "stryker run stryker.crypto.config.json",
    "mutation:auth": "stryker run stryker.auth.config.json"
  },
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "cloudflare",
    "workers",
    "password-manager"
  ],
  "cloudflare": {
    "bindings": {
      "JWT_SECRET": {
        "description": "Use a strong random string (32+ characters recommended)"
      },
      "DB": {
        "description": "D1 database for storing vault data"
      },
      "ATTACHMENTS": {
        "description": "R2 bucket for storing file attachments"
      },
      "ATTACHMENTS_KV": {
        "description": "Optional KV namespace fallback for attachment/send-file storage"
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "30.0.1",
    "opencc-js": "1.4.1",
    "oxlint": "1.79.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@tanstack/react-query": "5.101.4",
    "@zip.js/zip.js": "2.8.52",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "lucide-preact": "1.32.0",
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "wouter": "3.10.0"
  },
  "overrides": {
    "qs": "6.15.3",
    "undici": "8.10.0",
    "@babel/core": "8.0.1",
    "@vitest/coverage-istanbul": {
      "@babel/core": "7.29.7"
    },
    "@stryker-mutator/instrumenter": {
      "@babel/core": "7.29.7"
    },
    "esbuild": "0.28.2",
    "ws": "8.21.3",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
    "nanoid": "6.0.1",
    "sharp": "0.35.3"
  }
}
